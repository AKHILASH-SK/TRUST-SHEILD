<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/light_bg"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:titleTextColor="@android:color/white" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Verdict Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="20dp">

                    <ImageView
                        android:id="@+id/iv_verdict_icon"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/ic_check_circle"
                        android:layout_marginEnd="16dp" />

                    <TextView
                        android:id="@+id/tv_verdict"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="SAFE"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="@android:color/holo_green_dark" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- URL Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Link Details"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Full URL"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_full_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="https://example.com"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:textIsSelectable="true"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Host Name"
                        android:textSize="12sp"
                        android:textColor="@color/text_gray"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_host"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="example.com"
                        android:textSize="14sp"
                        android:textColor="@color/black" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- AI Forensic Investigation Card -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AI Forensic Intelligence"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_gray"
                android:layout_marginBottom="8dp"
                android:layout_marginStart="4dp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Header with Google Gemini badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <ImageView
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_shield"
                            app:tint="@color/accent_cyan"
                            android:layout_marginEnd="10dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Forensic Investigation"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_navy" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Google Gemini 3.6 Flash"
                                android:textSize="11sp"
                                android:textColor="@color/accent_cyan_dark"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_refresh_gemini"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Refresh"
                            android:textSize="12sp"
                            app:icon="@drawable/ic_refresh"
                            app:iconSize="16dp"
                            android:textColor="@color/accent_cyan" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#E2E8F0"
                        android:layout_marginBottom="16dp" />

                    <!-- Loading State -->
                    <LinearLayout
                        android:id="@+id/ll_gemini_loading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="24dp"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:indeterminateTint="@color/accent_cyan"
                            android:layout_marginBottom="12dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Synthesizing AI Forensic Intelligence..."
                            android:textSize="13sp"
                            android:textColor="@color/text_gray" />
                    </LinearLayout>

                    <!-- Content State -->
                    <LinearLayout
                        android:id="@+id/ll_gemini_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Threat Summary Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#F1F5F9"
                            android:padding="12dp"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="THREAT SUMMARY"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_navy"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tv_gemini_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Analyzing link telemetry..."
                                android:textSize="13sp"
                                android:lineSpacingExtra="3dp"
                                android:textColor="#1E293B" />
                        </LinearLayout>

                        <!-- Key Forensic Evidence Section -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#F8FAFC"
                            android:padding="12dp"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KEY FORENSIC EVIDENCE"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="@color/primary_navy"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tv_gemini_evidence"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Technical indicators..."
                                android:textSize="13sp"
                                android:lineSpacingExtra="3dp"
                                android:textColor="#334155" />
                        </LinearLayout>

                        <!-- Recommended Action Section -->
                        <LinearLayout
                            android:id="@+id/ll_gemini_action_box"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="#FEF2F2"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="RECOMMENDED ACTION"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                android:textColor="#DC2626"
                                android:layout_marginBottom="4dp" />

                            <TextView
                                android:id="@+id/tv_gemini_action"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Immediate security advice..."
                                android:textSize="13sp"
                                android:lineSpacingExtra="3dp"
                                android:textColor="#991B1B" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Metadata -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginTop="8dp">
                
                <TextView
                    android:id="@+id/tv_timestamp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Scanned: Jan 01, 2024 10:30 AM"
                    android:textSize="12sp"
                    android:textColor="@color/text_gray"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_source_app"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Source: Dashboard"
                    android:textSize="12sp"
                    android:textColor="@color/text_gray" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
