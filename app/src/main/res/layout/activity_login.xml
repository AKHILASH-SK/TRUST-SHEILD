<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    android:scrollbars="none">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <!-- Centered Container: Logo + Card grouped together -->
        <LinearLayout
            android:id="@+id/ll_center_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/tv_footer_terms"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintVertical_bias="0.48">

            <!-- Stacked TrustShield Logo (Shield on top, Wordmark below) -->
            <ImageView
                android:id="@+id/iv_logo"
                android:layout_width="170dp"
                android:layout_height="96dp"
                android:layout_marginBottom="26dp"
                android:src="@drawable/trustshield_logo_vertical"
                android:contentDescription="TrustShield Logo"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter" />

            <!-- Main Login Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeWidth="1dp"
                app:strokeColor="#EEF2F6"
                app:cardBackgroundColor="#FFFFFF">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="22dp"
                    android:paddingVertical="26dp">

                    <!-- Label 1: ENTER YOUR PHONE NUMBER -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENTER  YOUR  PHONE  NUMBER"
                        android:textColor="#64748B"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <!-- Combined Unified Phone Input Container -->
                    <LinearLayout
                        android:id="@+id/container_phone_combined"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_box"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- Country Code Selector (IN +91 ∨) -->
                        <LinearLayout
                            android:id="@+id/btn_country_code"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="?attr/selectableItemBackground">

                            <TextView
                                android:id="@+id/tv_country_code"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="IN +91"
                                android:textColor="#0F172A"
                                android:textSize="14.5sp"
                                android:textStyle="bold" />

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:layout_marginStart="6dp"
                                android:src="@drawable/ic_chevron_down"
                                app:tint="#64748B" />
                        </LinearLayout>

                        <!-- Thin Vertical Divider Line -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#CBD5E1" />

                        <!-- Phone Number Input Field -->
                        <EditText
                            android:id="@+id/et_phone_number"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Enter your phone number"
                            android:textColorHint="#94A3B8"
                            android:textColor="#0F172A"
                            android:textSize="14.5sp"
                            android:inputType="phone"
                            android:imeOptions="actionNext"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp"
                            android:maxLines="1" />
                    </LinearLayout>

                    <!-- Label 2: ENTER YOUR PIN -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="ENTER  YOUR  PIN"
                        android:textColor="#64748B"
                        android:textSize="11.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.04" />

                    <!-- PIN Input Box -->
                    <LinearLayout
                        android:id="@+id/container_pin"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_box"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock_outline"
                            app:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/et_pin"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:layout_marginEnd="8dp"
                            android:background="@null"
                            android:hint="Enter your pin"
                            android:textColorHint="#94A3B8"
                            android:textColor="#0F172A"
                            android:textSize="14.5sp"
                            android:inputType="numberPassword"
                            android:imeOptions="actionDone"
                            android:maxLines="1" />

                        <ImageView
                            android:id="@+id/iv_toggle_pin"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:padding="2dp"
                            android:src="@drawable/ic_visibility_off"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            app:tint="#94A3B8" />
                    </LinearLayout>

                    <!-- Primary Button: AUTHORIZE & CONTINUE -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="22dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_login"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="AUTHORIZE &amp; CONTINUE"
                            android:textColor="#FFFFFF"
                            android:textSize="14.5sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.02"
                            app:backgroundTint="#052971"
                            app:cornerRadius="12dp"
                            app:icon="@drawable/ic_arrow_forward"
                            app:iconGravity="textEnd"
                            app:iconTint="#FFFFFF"
                            app:iconPadding="10dp" />

                        <ProgressBar
                            android:id="@+id/progress_bar"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />
                    </FrameLayout>

                    <!-- Secondary Button: CREATE ACCOUNT -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_register"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="CREATE ACCOUNT"
                        android:textColor="#052971"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.02"
                        app:strokeColor="#CBD5E1"
                        app:strokeWidth="1dp"
                        app:cornerRadius="12dp"
                        app:backgroundTint="#FFFFFF" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Footer Terms & Privacy (cleanly anchored towards the bottom) -->
        <TextView
            android:id="@+id/tv_footer_terms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            android:gravity="center"
            android:text="Secured by TrustShield Neural Protocol. By verifying,\nyou agree to the Terms of Service &amp; Privacy Policy."
            android:textColor="#8A99AD"
            android:textSize="11sp"
            android:lineSpacingExtra="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
