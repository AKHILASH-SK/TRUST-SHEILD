<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    android:fillViewport="true"
    android:overScrollMode="never">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="36dp">

        <!-- Top Guidance Guideline -->
        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.14" />

        <!-- TrustShield Logo Header -->
        <ImageView
            android:id="@+id/iv_logo"
            android:layout_width="230dp"
            android:layout_height="58dp"
            android:src="@drawable/trustshield_logo"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:contentDescription="TrustShield Logo"
            app:layout_constraintBottom_toTopOf="@+id/card_login"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/guide_top"
            app:layout_constraintVertical_bias="0.4" />

        <!-- Main Authentication Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_login"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="36dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeColor="#EEF2F6"
            app:strokeWidth="1dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/iv_logo">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="22dp"
                android:paddingTop="26dp"
                android:paddingBottom="26dp">

                <!-- Phone Section Header Label -->
                <TextView
                    android:id="@+id/tv_label_phone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTER  YOUR  PHONE  NUMBER"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginBottom="9dp" />

                <!-- Combined Phone Number Container -->
                <LinearLayout
                    android:id="@+id/ll_phone_container"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_box"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- Country Code Selector Container -->
                    <LinearLayout
                        android:id="@+id/ll_country_code"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_country_code"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="US +1"
                            android:textColor="#0F172A"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_chevron_down"
                            android:layout_marginStart="6dp"
                            android:contentDescription="Select Country"
                            app:tint="#64748B" />
                    </LinearLayout>

                    <!-- Vertical Separator Line -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="12dp"
                        android:background="#CBD5E1" />

                    <!-- Phone Number Input Field -->
                    <EditText
                        android:id="@+id/et_phone_number"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="(555) 234-8900"
                        android:textColorHint="#94A3B8"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:inputType="phone"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        tools:ignore="Autofill,TextFields" />
                </LinearLayout>

                <!-- PIN Section Header Label -->
                <TextView
                    android:id="@+id/tv_label_pin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENTER  YOUR  PIN"
                    android:textColor="#64748B"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05"
                    android:textAllCaps="true"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="9dp" />

                <!-- PIN Input Container -->
                <LinearLayout
                    android:id="@+id/ll_pin_container"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_input_box"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <!-- Lock Icon -->
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock_outline"
                        android:layout_marginEnd="10dp"
                        android:contentDescription="PIN Lock"
                        app:tint="#94A3B8" />

                    <!-- PIN Input Field -->
                    <EditText
                        android:id="@+id/et_pin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="Enter your pin"
                        android:textColorHint="#94A3B8"
                        android:textColor="#0F172A"
                        android:textSize="15sp"
                        android:inputType="numberPassword"
                        android:singleLine="true"
                        android:imeOptions="actionDone"
                        tools:ignore="Autofill,TextFields" />

                    <!-- Password Toggle Icon -->
                    <ImageView
                        android:id="@+id/iv_toggle_pin"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_visibility_off_eye"
                        android:contentDescription="Toggle PIN Visibility"
                        android:padding="2dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        app:tint="#94A3B8" />
                </LinearLayout>

                <!-- Authorize & Continue Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_login"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:text="Authorize &amp; Continue"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    app:backgroundTint="@null"
                    android:background="@drawable/bg_button_navy"
                    app:cornerRadius="10dp"
                    app:icon="@drawable/ic_arrow_forward_white"
                    app:iconGravity="textEnd"
                    app:iconPadding="8dp"
                    app:iconTint="#FFFFFF"
                    app:elevation="0dp" />

                <!-- Loading Indicator -->
                <ProgressBar
                    android:id="@+id/progress_bar"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    android:indeterminateTint="#031C5E" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security & Legal Footer -->
        <TextView
            android:id="@+id/tv_footer_security"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginHorizontal="32dp"
            android:text="Secured by TrustShield Neural Protocol. By verifying,\nyou agree to the Terms of Service &amp; Privacy Policy."
            android:textColor="#64748B"
            android:textSize="11.5sp"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_login" />

        <!-- Register Link for Account Creation -->
        <TextView
            android:id="@+id/btn_register"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="New to TrustShield? Create an Account"
            android:textColor="#0066FF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_footer_security" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
