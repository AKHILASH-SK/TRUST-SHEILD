# ===================================================
# TRUSTSHIELD ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and adjust your settings.
# ===================================================

# Set to 'local' to use your laptop backend, or 'hosted' to use Render cloud
BACKEND_ENV=local

# Local Backend Settings (When BACKEND_ENV=local)
BACKEND_IP=192.168.137.1
BACKEND_PORT=8000

# Hosted Cloud Settings (When BACKEND_ENV=hosted)
HOSTED_BACKEND_URL=https://trust-sheild.onrender.com/


# ===================================================
# BACKEND SERVER SETTINGS (set these on the server, never commit real values)
# ===================================================
TRUSTSHIELD_ENV=development
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(48))"
EVIDENCE_SIGNING_KEY=generate-a-different-long-random-value
ADMIN_API_KEY=generate-a-long-random-value-for-admin-endpoints
DB_HOST=
DB_PORT=5432
DB_NAME=trustshield_db
DB_USER=
DB_PASSWORD=
VIRUSTOTAL_API_KEY=
GEMINI_API_KEY=
PHISHTANK_API_KEY=
CORS_ORIGINS=https://akhilash-sk.github.io
ENABLE_SCHEDULER=false
